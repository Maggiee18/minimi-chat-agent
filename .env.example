# Model: set ONE of these two.
GEMINI_API_KEY=           # FREE: https://aistudio.google.com/apikey (no card needed)
ANTHROPIC_API_KEY=        # paid: https://platform.claude.com (used if set)

# Search (free tier, 1,000 searches/month): https://app.tavily.com
TAVILY_API_KEY=

# Optional (defaults shown)
# PORT=3000
# PROVIDER=                        # auto: anthropic if its key is set, else gemini. Or "openai" for any OpenAI-compatible API
# ANSWER_MODEL=                    # claude-sonnet-5-5, or for Gemini a fallback list: gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
# NOTE_MODEL=                      # gemini-3.1-flash-lite | claude-haiku-5-5
# OPENAI_BASE_URL= / OPENAI_API_KEY=   # only with PROVIDER=openai (Groq, OpenRouter, Ollama…)
# THINKING=between_tools           # Anthropic only: between_tools | adaptive | off
# EFFORT=medium                    # Anthropic only: low | medium | high
# MAX_SEARCH_ROUNDS=4
# DB_PATH=data/agent.db
