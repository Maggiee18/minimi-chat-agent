# Models: set at least one. Every key you set becomes a backup for the others,
# so when one free tier runs out or is overloaded, the next one answers.
GEMINI_API_KEY=           # FREE: https://aistudio.google.com/apikey (no card)
GROQ_API_KEY=             # FREE: https://console.groq.com/keys (no card, ~1,000 requests/day per model)
OPENROUTER_API_KEY=       # FREE models: https://openrouter.ai/keys
ANTHROPIC_API_KEY=        # paid, best quality: https://platform.claude.com (goes first if set)

# Search (free tier, 1,000 searches/month): https://app.tavily.com
TAVILY_API_KEY=

# Optional (defaults shown)
# PORT=3000
# PROVIDER=                        # which backend goes first: anthropic | gemini | groq | openrouter | openai
# ANSWER_MODEL= / NOTE_MODEL=      # override the first backend's models (comma list = fallbacks)
# OPENAI_BASE_URL= / OPENAI_API_KEY=   # any other OpenAI-compatible API (Ollama, Together…), needs ANSWER_MODEL
# THINKING=between_tools           # Claude only: between_tools | adaptive | off
# EFFORT=medium                    # Claude only: low | medium | high
# MAX_SEARCH_ROUNDS=4
# DB_PATH=data/agent.db
