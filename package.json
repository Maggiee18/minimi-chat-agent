{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "description": "A fast, honest chat agent with web search and dated memory",
  "scripts": {
    "dev": "tsx watch --no-warnings --clear-screen=false src/server.ts",
    "start": "tsx --no-warnings src/server.ts",
    "typecheck": "tsc -p .",
    "test": "tsx --no-warnings --test test/*.test.ts",
    "seed": "tsx --no-warnings scripts/seed.ts",
    "eval": "tsx --no-warnings scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "chrono-node": "^2.10.3",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
